# FastGen environment configuration template.
#
# Copy to `.env` at the repository root and adjust. `fastgen/__init__.py` loads `.env`
# with python-dotenv when the package is imported, before the config modules read the
# environment, so these values become the defaults for the roots below. Variables already
# exported in the shell (e.g. by the job scheduler or CI) always take precedence. `${VAR}` references
# expand from earlier entries and from the shell. Keep secrets (W&B, Hugging Face, S3 keys)
# out of this file: export them or use the config's credentials_dir (./credentials/ by
# default), as described in fastgen/configs/README.md. Non-empty credential files loaded
# during setup override their matching environment variables.

# Root for run outputs (checkpoints, logs); also the base of the DATA/MODEL/.cache roots.
FASTGEN_OUTPUT_ROOT=./FASTGEN_OUTPUT

# Dataset root and root for local pretrained checkpoints (mirrored S3/HTTP files land here).
DATA_ROOT_DIR=${FASTGEN_OUTPUT_ROOT}/DATA
CKPT_ROOT_DIR=${FASTGEN_OUTPUT_ROOT}/MODEL

# Remote prepared-dataset prefix (S3 or HTTP(S)). S3 credentials use the standard AWS
# environment or s3.json in the config's credentials_dir (default ./credentials/).
# REMOTE_DATA_ROOT_DIR=s3://data

# Hugging Face cache. Defaults to $FASTGEN_OUTPUT_ROOT/.cache; point it at a shared,
# pre-populated cache to reuse downloads. Set LOCAL_FILES_ONLY=true to run offline.
# HF_HOME=/path/to/shared/hf_cache
LOCAL_FILES_ONLY=false

# Reduce allocator fragmentation in long and multi-forward GPU workloads. Keep both equal:
# older PyTorch reads the CUDA name, newer PyTorch reads the generic name.
PYTORCH_ALLOC_CONF=expandable_segments:True
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

# One intra-op CPU thread per process. FastGen's main process is GPU-bound, so extra
# OpenMP workers only spin against the DataLoader workers (no gain measured at 16 threads),
# and one thread keeps CPU reductions deterministic. torchrun sets this itself for
# nproc_per_node > 1; the entry covers single-process launches. Raise to 2-4 only when a
# profile shows the main process CPU-bound on tensor work (e.g. num_workers=0 preprocessing).
OMP_NUM_THREADS=1

# OpenAI-compatible endpoint for the VLM log module (VLMLogger); the bearer token comes from
# OPENAI_API_KEY or vlm_api_token.txt in the config's credentials_dir.
# VLM_BASE_URL=https://api.openai.com/v1
